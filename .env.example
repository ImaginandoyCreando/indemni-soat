APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/Bogota

# UltraMsg WhatsApp API (configurar como Secrets en Koyeb)
WHATSAPP_BASE_URL=https://api.ultramsg.com
WHATSAPP_INSTANCE_ID=
WHATSAPP_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=indemni_soat
DB_USERNAME=root
DB_PASSWORD=

# Microsoft Graph API Integration (SOLUCIÓN DEFINITIVA - SIN EXTENSIÓN IMAP)
# Cuenta 1: gestionsoat365@outlook.com (ALTA PRIORIDAD - Respuestas aseguradoras, tutelas, honorarios)
GESTION_EMAIL=gestionsoat365@outlook.com
GESTION_PASSWORD=coloca_aqui_la_clave_de_aplicacion

# Cuenta 2: reclamacionessoat@hotmail.com (ALTA PRIORIDAD - Pagos e indemnizaciones)
RECLAMACIONES_EMAIL=reclamacionessoat@hotmail.com
RECLAMACIONES_PASSWORD=coloca_aqui_la_clave_de_aplicacion

# Microsoft Graph API Configuration (CORREGIDO para cuentas personales Outlook/Hotmail)
MICROSOFT_GRAPH_CLIENT_ID=tu_client_id_aqui
MICROSOFT_GRAPH_CLIENT_SECRET=tu_client_secret_aqui
MICROSOFT_GRAPH_TENANT_ID=consumers
MICROSOFT_GRAPH_REDIRECT_URI=https://{{ KOYEB_PUBLIC_DOMAIN }}/outlook/callback

# OAuth web opcional para conectar Outlook desde el panel
OUTLOOK_CLIENT_ID=tu_client_id_aqui
OUTLOOK_CLIENT_SECRET=tu_client_secret_aqui

# Email Processing
EMAIL_SYNC_ENABLED=true
EMAIL_DEBUG=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
